<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<div class="report" data-testid="cucumber-report">
<header class="report-head">
  <h1>{{.Title}}</h1>
  <div class="subtitle">
    {{if .Verdict}}<span class="verdict {{.Verdict}}">{{.VerdictText}}</span> · {{end}}
    {{.Summary.Scenarios}} scenarios · {{.Summary.Steps}} steps · {{durationText}}
  </div>
</header>

{{if .Empty}}
  <div class="empty">No features in this run.</div>
{{else}}
<section class="summary">
  {{range .Stats}}<div class="stat"><div class="n">{{.N}}</div><div class="k">{{.K}}</div></div>{{end}}
  <div class="stat"><div class="n">{{durationText}}</div><div class="k">duration</div></div>
</section>

{{if .ScenarioBar}}
<div class="bar" role="img" aria-label="scenario status breakdown">
  {{range .ScenarioBar}}<span class="{{.Class}}" style="width:{{printf "%.2f" .Percent}}%" title="{{.Count}} {{.Label}}"></span>{{end}}
</div>
<div class="legend">
  {{range .Legend}}<span class="{{.Class}}"><span class="dot" style="background:var(--c)"></span>{{.Count}} {{.Label}}</span>{{end}}
</div>
{{end}}

<div class="toolbar">
  <button type="button" data-act="expand">Expand all</button>
  <button type="button" data-act="collapse">Collapse all</button>
  <label><input type="checkbox" data-act="failures"> Failures only</label>
</div>

{{range .Features}}
<details class="feature" open>
  <summary>
    <span class="marker">▸</span>
    <span class="sdot status-{{.StatusClass}}" style="background:var(--c)"></span>
    <span class="title">{{.Keyword}}: {{.Name}}</span>
    {{if .URI}}<span class="uri">{{.URI}}</span>{{end}}
    <span class="time">{{.Duration}}</span>
  </summary>
  {{if .Tags}}<div class="scenario-wrap"><span class="tags">{{range .Tags}}<span class="tag">{{.}}</span>{{end}}</span></div>{{end}}
  {{if .Description}}<div class="feature-desc">{{.Description}}</div>{{end}}
  {{range .Scenarios}}
  <details class="scenario" data-status="{{.Status}}">
    <summary>
      <span class="marker">▸</span>
      <span class="sdot status-{{.StatusClass}}" style="background:var(--c)"></span>
      <span class="title">{{.Keyword}}: {{.Name}}</span>
      {{if .Tags}}<span class="tags">{{range .Tags}}<span class="tag">{{.}}</span>{{end}}</span>{{end}}
      <span class="time">{{.Duration}}</span>
    </summary>
    <div class="scenario-wrap">
    {{if .Description}}<div class="feature-desc" style="padding-left:0">{{.Description}}</div>{{end}}
    <ol class="steps">
      {{range .Steps}}
      <li class="status-{{.StatusClass}}">
        <div class="step-line">
          <span class="sdot" style="background:var(--c)" title="{{.StatusText}}"></span>
          <span class="step-kw {{if .IsHook}}hook-kw{{end}}">{{.Keyword}}</span>
          <span class="step-name">{{.Name}}</span>
          <span class="step-time">{{.Duration}}</span>
        </div>
        {{if .Location}}<div class="step-loc">{{.Location}}</div>{{end}}
        {{if .DocString}}<pre class="docstring">{{.DocString}}</pre>{{end}}
        {{if .Rows}}<table class="datatable"><tbody>{{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}</tbody></table>{{end}}
        {{if .ErrorMessage}}<pre class="err">{{.ErrorMessage}}</pre>{{end}}
        {{range .Output}}<pre class="out">{{.}}</pre>{{end}}
        {{if .Embeds}}
        <div class="embeds">
          {{range .Embeds}}
          <details>
            <summary>📎 {{.Name}}</summary>
            {{if .IsImage}}<img loading="lazy" alt="{{.Name}}" src="{{.Src}}">
            {{else if .IsText}}<pre class="text-embed">{{.Text}}</pre>
            {{else if .Download}}<a class="download" download href="{{.Src}}">Download {{.Name}}</a>
            {{end}}
          </details>
          {{end}}
        </div>
        {{end}}
      </li>
      {{end}}
    </ol>
    </div>
  </details>
  {{end}}
</details>
{{end}}
{{end}}

<footer class="report-foot">Generated by draiver · self-contained cucumber report</footer>
</div>
<script>{{.JS}}</script>
</body>
</html>
